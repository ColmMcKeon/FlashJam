ReturnCall = new Object();
ReturnCall.onKeyDown = function()
{
   Selection.setFocus(my_lb);
   if(key.getCode() == 32)
   {
      playSong();
   }
   else if(key.getCode() == 39)
   {
      playNextSong();
   }
   else if(key.getCode() == 37)
   {
      ToggleMode();
   }
   else if(key.getCode() == 17)
   {
      stopSong();
   }
   else if(key.getCode() != 38)
